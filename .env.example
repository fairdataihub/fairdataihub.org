# S3 backup (scripts/s3_backup.ts)

# Source: Bunny Storage
BUNNY_ENDPOINT=https://<storage_zone_region>-s3.storage.bunnycdn.com
BUNNY_BUCKET="<storage_zone_name>"
# Bunny uses the storage zone name as the access key id
BUNNY_ACCESS_KEY_ID="<storage_zone_name>"
# Use the storage zone's read-only password
BUNNY_SECRET_ACCESS_KEY=
BUNNY_REGION="<storage_zone_region>"

# Destination: Cloudflare R2
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET="bucket_name"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION="auto"

# Optional
SNAPSHOT_PREFIX=snapshots/
KEEP_DAILY=30
KEEP_MONTHLY=12
CONCURRENCY=8
